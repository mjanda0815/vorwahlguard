{
  "$schema": "https://json-schema.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(adb devices:*)",
      "Bash(adb version:*)",
      "Bash(adb logcat:*)",
      "Bash(apksigner verify:*)",
      "Bash(sha256sum:*)",
      "Bash(source scripts/adb-env.sh)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(rm -rf:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(keytool:*)",
      "Bash(apksigner sign:*)",
      "Bash(adb kill-server:*)",
      "Read(./local.properties)",
      "Read(./keystore.properties)",
      "Read(./signing.properties)",
      "Read(**/*.jks)",
      "Read(**/*.keystore)",
      "Read(**/*.p12)",
      "Read(~/.gradle/gradle.properties)",
      "Read(~/keys/**)",
      "Read(**/.env)",
      "Read(**/.env.*)"
    ],
    "ask": [
      "Bash(gh release:*)",
      "Bash(gh repo:*)",
      "Bash(adb install:*)",
      "Bash(adb uninstall:*)",
      "Bash(adb push:*)",
      "Bash(adb shell:*)",
      "Bash(adb tcpip:*)",
      "Bash(adb connect:*)",
      "Bash(adb pair:*)",
      "Bash(adb root:*)",
      "Edit(.github/workflows/**)",
      "Edit(app/src/main/AndroidManifest.xml)"
    ],
    "defaultMode": "default"
  },
  "model": "opusplan"
}
