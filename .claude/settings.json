{
  "$schema": "https://json-schema.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(gh *)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(rm -rf:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Read(./local.properties)",
      "Read(./keystore.properties)",
      "Read(./signing.properties)",
      "Read(**/*.jks)",
      "Read(**/*.keystore)",
      "Read(**/.env)",
      "Read(**/.env.*)"
    ],
    "ask": [
      "Bash(gh release:*)",
      "Bash(gh repo:*)",
      "Edit(.github/workflows/**)",
      "Edit(app/src/main/AndroidManifest.xml)"
    ],
    "defaultMode": "default"
  },
  "model": "opusplan"
}
