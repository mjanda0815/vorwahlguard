{
  "$schema": "https://json-schema.org/claude-code-settings.json",
  "model": "opusplan",
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Bash(./gradlew:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git branch:*)",
      "Bash(git pull:*)",
      "Bash(git worktree:*)",
      "Bash(gh issue:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh run:*)",
      "Bash(adb devices)",
      "Bash(adb version)",
      "Bash(adb install:*)",
      "Bash(adb uninstall:*)",
      "Bash(adb logcat:*)",
      "Bash(apksigner verify:*)",
      "Bash(sha256sum:*)",
      "Bash(source scripts/adb-env.sh)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh release:*)",
      "Bash(gh repo:*)",
      "Edit(.github/workflows/**)",
      "Edit(app/src/main/AndroidManifest.xml)",
      "Bash(adb shell:*)",
      "Bash(adb tcpip:*)",
      "Bash(adb connect:*)",
      "Bash(adb root)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(rm -rf:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Read(./local.properties)",
      "Read(./keystore.properties)",
      "Read(./signing.properties)",
      "Read(**/*.jks)",
      "Read(**/*.keystore)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Bash(keytool:*)",
      "Bash(apksigner sign:*)",
      "Read(~/.gradle/gradle.properties)",
      "Read(**/*.p12)",
      "Bash(adb kill-server)"
    ]
  }
}
