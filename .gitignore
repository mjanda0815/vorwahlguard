# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
local.properties

# Android
*.apk
*.aab
*.ap_
*.dex
*.class
bin/
gen/
# Anchored to the repo root: this is IntelliJ's classic (non-Gradle) compiler output
# directory. An unanchored `out/` also matches `.../port/out/`, the driven-port package
# docs/ARCHITECTURE.md specifies for every module — that silently blocked every file under
# it from ever being tracked. Gradle output is already covered by `build/` above.
/out/
release/
captures/
.externalNativeBuild/
.cxx/

# Signing — never commit these
*.jks
*.keystore
*.p12
keystore.properties
signing.properties

# IDE
.idea/
!.idea/codeStyles/
*.iml
.DS_Store

# Claude Code (local overrides stay local)
.claude/settings.local.json
