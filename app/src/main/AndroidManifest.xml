<?xml version="1.0" encoding="utf-8"?>
<!--
  VorwahlGuard manifest.

  NON-NEGOTIABLE: this file must never declare any network permission (no INTERNET, no
  network-state access). CI fails the build if one appears. See CLAUDE.md §1 and §12.

  The CallScreeningService (VorwahlGuardScreeningService) is declared here with the required
  BIND_SCREENING_SERVICE permission, intent filter and android:exported="true" (CLAUDE.md §3
  rule 6). It is fully implemented: it screens incoming calls against the user's rules and, on
  any exception, falls through to allowing the call (fail-open, CLAUDE.md §3 rule 3).

  READ_CONTACTS (issue #29, user-approved) is the app's first and only declared permission. It
  is not a network permission and leaves the invariant above unchanged — it powers the on-device
  contacts-bypass rule (CachedContactsLookup): looked-up numbers never leave the device and are
  never logged.

  allowBackup is "false" on purpose: Android's Auto Backup transport needs no INTERNET permission
  in the app itself, so it is not covered by the CI check above, but it would still copy
  vorwahlguard.db (raw E.164 numbers whenever pseudonymisation is off, which is the default) and
  the settings DataStore (the pseudonymisation salt) to the user's Google Drive. That breaks the
  "phone numbers never leave the device" promise just as surely as a network permission would.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <application
        android:name=".VorwahlGuardApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.VorwahlGuard">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.VorwahlGuard">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".screening.VorwahlGuardScreeningService"
            android:exported="true"
            android:permission="android.permission.BIND_SCREENING_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>

    </application>

</manifest>
