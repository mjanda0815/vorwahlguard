<?xml version="1.0" encoding="utf-8"?>
<!--
  VorwahlGuard manifest.

  NON-NEGOTIABLE: this file must never declare any network permission (no INTERNET, no
  network-state access). CI fails the build if one appears. See CLAUDE.md §1 and §12.

  The CallScreeningService is declared here (permission + intent filter + exported) but its
  screening logic is not implemented yet — M0 ships a fail-open stub. See CLAUDE.md §3, §M2.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:name=".VorwahlGuardApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.VorwahlGuard">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.VorwahlGuard">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".screening.VorwahlGuardScreeningService"
            android:exported="true"
            android:permission="android.permission.BIND_SCREENING_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>

    </application>

</manifest>
